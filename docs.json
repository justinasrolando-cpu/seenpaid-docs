              "guides/track-your-sales"
            ]
          },
          {
            "group": "Use seenpaid",
            "pages": [
              "guides/publish-and-schedule",
              "guides/revenue-and-top-earners",
              "guides/recycle",
              "guides/autopilot-and-experiments"
            ]
          }
        ]
      },
      {
